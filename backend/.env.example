# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/traffic_management?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="traffic_light_wcu_super_secret_access_key_change_in_production_2026"
JWT_REFRESH_SECRET="traffic_light_wcu_super_secret_refresh_key_change_in_production_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & Policies
ALLOW_INACTIVE_LOGIN=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# MQTT Broker Configuration
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="traffic_backend_service"
MQTT_SIMULATOR_ENABLED=true

# Storage / Evidence Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=5242880
